  "core_corrections": [
    {
      "id": "MX-F-ARTIFACT",
      "field": "state",
      "before": "Artifact linked to a task and query basis",
      "after": "Report artifact, originating conversation or task, and query basis",
      "reason": "Report generation also returns artifacts in conversation; a task is not a universal parent resource.",
      "official_sources": [
        "https://docs.aws.amazon.com/finops-agent/latest/userguide/custom-cost-reporting.html"
      ]
    },
    {
      "id": "MX-F-MEMORY",
      "field": "trigger",
      "before": "Explicit remember, update or forget request",
      "after": "Conversation preferences, corrections or task outcomes; explicit remember, update or forget requests",
      "reason": "The memory input model includes retained task outcomes and is not limited to imperative remember requests.",
      "official_sources": [
        "https://docs.aws.amazon.com/finops-agent/latest/userguide/context-files-and-memory.html"
      ]
    },
    {
      "id": "MX-S-GENERATE",
      "field": "trigger",
      "before": "Approved policy source is submitted",
      "after": "Policy documents are submitted for requirement generation",
      "reason": "Approval of policy source is a team control, not a documented service-side approval gate.",
      "official_sources": [
        "https://docs.aws.amazon.com/securityagent/latest/userguide/security-requirements.html"
      ]
    },
    {
      "id": "MX-D-QUERY",
