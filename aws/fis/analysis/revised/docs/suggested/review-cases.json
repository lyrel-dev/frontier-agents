{
  "schemaVersion": "assessment-review-cases/0.2",
  "title": "Independent behavioral review cases",
  "purpose": "Normative counterexamples for the reviewed proposal. These examples describe contract decisions; they do not execute workflows, compile CEL, authenticate evidence, contact AWS, or establish receiver coverage.",
  "conventions": {
    "assessment": "requiredCriteria is the immutable admission denominator. results maps step keys to check verdicts; executionOutcomes and notApplicableCriteria are explanatory context. Missing final results are inconclusive; missing live results are pending.",
    "eligibility": "dependencyOutcomes contains null for locally nonterminal prerequisites. preconditionVerdicts contains the already determined transitive guard set. criterionVerdicts is explanatory and never an implicit gate. Static validation rejects settled main mutations.",
    "proof": "matchingRecords is the count of already validated records matching the declared identity, temporal and claim scope; it is not a raw row count. windowClosed is a real observation fact, never inferred solely from elapsed wall time. The helper does not authenticate sources or establish coverage.",
    "cancellation": "A tokenReplay identifies a retained command receipt in the same trusted workspace, principal and operation scope. Payload equality and authorization are assumed to have been established by the API boundary.",
    "termination": "All cases are evaluated at sealing after bounded finalization. unresolvedEffects includes active, unknown, or ambiguous mutating effects requiring continued protection. retainScopeHold concerns unresolved remote effects, not an assertion that all other admission policies permit another Run."
  },
  "cases": [
    {
