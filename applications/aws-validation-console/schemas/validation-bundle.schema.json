{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "metric": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lte",
            "gte",
            "eq"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "number"
            }
          ],
          "title": "Threshold"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "category": {
          "enum": [
            "collection",
            "application",
            "recovery",
            "data",
            "detection",
            "response",
            "safety"
          ],
          "title": "Category",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "min_samples": {
          "default": 1,
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Min Samples",
          "type": "integer"
        },
        "max_collection_lag_seconds": {
          "default": 300,
          "maximum": 604800,
          "minimum": 0,
          "title": "Max Collection Lag Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "metric",
        "operator",
        "threshold",
        "unit",
        "category"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_assessed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        }
      },
      "required": [
        "assertion_id",
        "title",
        "category",
        "required",
        "outcome",
        "reason",
        "expected"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "maxLength": 300,
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "denied",
            "error",
            "truncated",
            "not_requested"
          ],
          "title": "Status",
          "type": "string"
        },
        "resource_count": {
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        },
        "error_code": {
          "default": "",
          "maxLength": 200,
          "title": "Error Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 3000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "status",
        "resource_count"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EvidenceData": {
      "additionalProperties": false,
      "properties": {
        "run_ref": {
          "pattern": "^(scenario|execution_run|evidence|snapshot|validation_run|report):[A-Za-z0-9][A-Za-z0-9_.-]{0,99}@[1-9][0-9]*$",
          "title": "Run Ref",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "metric": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "sample_count": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 6000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "run_ref",
        "scope_id",
        "metric",
        "value",
        "unit",
        "sample_count",
        "window_start",
        "window_end",
        "collected_at",
        "source"
      ],
      "title": "EvidenceData",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
