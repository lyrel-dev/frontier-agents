        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_assessed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "maxItems": 50,
          "title": "Checks",
          "type": "array"
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Gates",
          "type": "array"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "run_ref",
        "scenario_ref",
        "evaluator_version",
        "evaluated_at",
        "outcome"
      ],
      "title": "ValidationData",
      "type": "object"
    },
    "ValidationRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "kind": {
          "const": "validation_run",
          "title": "Kind",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ValidationData"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "data"
      ],
      "title": "ValidationRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "validation_bundle",
      "default": "validation_bundle",
      "title": "Kind",
      "type": "string"
    },
    "records": {
      "items": {
        "discriminator": {
          "mapping": {
            "evidence": "#/$defs/EvidenceRecord",
            "execution_run": "#/$defs/RunRecord",
            "report": "#/$defs/ReportRecord",
            "scenario": "#/$defs/ScenarioRecord",
            "snapshot": "#/$defs/SnapshotRecord",
            "validation_run": "#/$defs/ValidationRecord"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ScenarioRecord"
          },
          {
            "$ref": "#/$defs/RunRecord"
          },
          {
            "$ref": "#/$defs/EvidenceRecord"
          },
          {
            "$ref": "#/$defs/SnapshotRecord"
          },
          {
            "$ref": "#/$defs/ValidationRecord"
          },
          {
            "$ref": "#/$defs/ReportRecord"
          }
        ]
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "manifest": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest"
    }
  },
  "required": [
    "records"
  ],
  "title": "Bundle",
  "type": "object"
}