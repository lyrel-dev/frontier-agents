{
  "status": "OFFLINE_NORMATIVE_CASES",
  "scope": "Alternative fixture datasets exercise structure, identity, evidence prerequisites and cross-artifact invariants. No case executes a predicate, provider call, scheduler, database or authorization system.",
  "cases": [
    {
      "id": "execution-and-acceptance-independent",
      "description": "Successful technical execution coexists with a failed required acceptance criterion.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "Run",
          "id": "run-checkout",
          "path": "/executionOutcome",
          "equals": "SUCCEEDED"
        },
        {
          "entity": "Run",
          "id": "run-checkout",
          "path": "/assessmentVerdict",
          "equals": "FAIL"
        }
      ]
    },
    {
      "id": "local-review-does-not-repair-source",
      "description": "Local review completion leaves the provider finding open and Health impact pending.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "WorkItem",
          "id": "workitem-review",
          "path": "/state",
          "equals": "RESOLVED"
        },
        {
          "entity": "Finding",
          "id": "finding-single-node",
          "path": "/rawDisposition",
          "equals": "OPEN"
        },
        {
          "entity": "EntityImpact",
          "id": "impact-db",
          "path": "/rawProviderStatus",
          "equals": "PENDING"
        }
      ]
    },
    {
      "id": "observation-is-not-revision",
      "description": "Two successful reads of the same payload retain two observations and one source revision.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "Observation",
          "id": "obs-health-impact",
          "path": "/sourceRevisionId",
          "equals": "src-health-impact"
        },
        {
          "entity": "Observation",
          "id": "obs-health-impact-repeat",
          "path": "/sourceRevisionId",
          "equals": "src-health-impact"
        }
      ]
    },
    {
      "id": "finding-has-no-required-assessment-foreign-key",
      "description": "A service-scoped finding is valid without inventing membership in an assessment result set.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "Finding",
          "id": "finding-single-node",
          "path": "/serviceId",
          "equals": "svc-checkout"
        }
      ]
    },
    {
      "id": "failed-read-preserves-unknown-count",
      "description": "An access failure retains its error and unknown count instead of creating an empty successful response.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "ReadAttempt",
          "id": "read-external-traces",
          "path": "/returnedCount",
          "equals": null
        },
        {
          "entity": "ReadAttempt",
          "id": "read-external-traces",
          "path": "/error/code",
          "equals": "AccessDenied"
        }
      ]
    },
    {
      "id": "states-are-independent",
      "description": "Successful assessment execution, unmet posture and degraded runtime health remain independent dimensions.",
      "expect": "VALID",
      "mutations": [],
      "assertions": [
        {
          "entity": "ProjectionRevision",
          "id": "projection-service-status",
          "path": "/value/assessmentExecution/state",
          "equals": "SUCCEEDED"
        },
        {
          "entity": "ProjectionRevision",
          "id": "projection-service-status",
          "path": "/value/resiliencePosture/state",
          "equals": "NOT_ACHIEVABLE"
        },
        {
          "entity": "ProjectionRevision",
          "id": "projection-service-status",
          "path": "/value/runtimeHealth/state",
          "equals": "DEGRADED"
        }
      ]
    },
