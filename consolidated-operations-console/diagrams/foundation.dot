digraph Model {
graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.9, ranksep=1.0, newrank=true, splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Consolidated Operations Console — Shared foundation"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, labelfontsize=9, labeldistance=2.5, labelangle=25, color="#718096", arrowsize=0.65];
subgraph cluster_0 {
label="Shared foundation"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_0_top [shape=point,width=0,height=0,label="",style=invis];
anchor_0_bottom [shape=point,width=0,height=0,label="",style=invis];
Workspace [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Workspace</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">workspaceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">enabledModules: List[enum]</FONT></TD></TR></TABLE>>];
Connection [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Connection</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">connectionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">provider: string</FONT></TD></TR></TABLE>>];
Resource [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Resource</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resourceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedObservationId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identityStability: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">incarnationKey: string | null</FONT></TD></TR></TABLE>>];
Collection [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Collection</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">collectionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">connectionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">projectionVersion: Version</FONT></TD></TR></TABLE>>];
ReadAttempt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>ReadAttempt</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">readAttemptId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">collectionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">providerRequestId: string | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">requestSourceRevisionId: Id</FONT></TD></TR></TABLE>>];
SourceRevision [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>SourceRevision</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sourceRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">profile: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">representation: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">profileVersion: string</FONT></TD></TR></TABLE>>];
Observation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Observation</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">observationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sourceRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">readAttemptId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">connectionId: Id | null</FONT></TD></TR></TABLE>>];
ProjectionRevision [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>ProjectionRevision</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">projectionRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">profile: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">projectionKey: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">profileVersion: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subjectRefs: List[EntityRef]</FONT></TD></TR></TABLE>>];
Snapshot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Snapshot</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">snapshotId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kind: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subjectRefs: List[EntityRef]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">capturedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">manifestDigest: Digest</FONT></TD></TR></TABLE>>];
WorkItem [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>WorkItem</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">workItemId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title: string</FONT></TD></TR></TABLE>>];
Command [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EAF1F8"><B>Command</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">commandId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">operation: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subjectRefs: List[EntityRef]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">actor: ActorRef</FONT></TD></TR></TABLE>>];
{rank=same; Workspace; Connection;}
Workspace -> Connection [style=invis,weight=100];
anchor_0_top -> Workspace [style=invis,weight=100];
anchor_0_top -> Connection [style=invis,weight=100];
{rank=same; Resource; Collection;}
Resource -> Collection [style=invis,weight=100];
Workspace -> Resource [style=invis,weight=100];
Workspace -> Collection [style=invis,weight=100];
Connection -> Resource [style=invis,weight=100];
Connection -> Collection [style=invis,weight=100];
{rank=same; SourceRevision; ReadAttempt;}
SourceRevision -> ReadAttempt [style=invis,weight=100];
Resource -> SourceRevision [style=invis,weight=100];
Resource -> ReadAttempt [style=invis,weight=100];
Collection -> SourceRevision [style=invis,weight=100];
Collection -> ReadAttempt [style=invis,weight=100];
{rank=same; Observation;}
SourceRevision -> Observation [style=invis,weight=100];
ReadAttempt -> Observation [style=invis,weight=100];
{rank=same; ProjectionRevision; Snapshot;}
ProjectionRevision -> Snapshot [style=invis,weight=100];
Observation -> ProjectionRevision [style=invis,weight=100];
Observation -> Snapshot [style=invis,weight=100];
{rank=same; WorkItem; Command;}
WorkItem -> Command [style=invis,weight=100];
ProjectionRevision -> WorkItem [style=invis,weight=100];
ProjectionRevision -> Command [style=invis,weight=100];
Snapshot -> WorkItem [style=invis,weight=100];
Snapshot -> Command [style=invis,weight=100];
WorkItem -> anchor_0_bottom [style=invis,weight=100];
Command -> anchor_0_bottom [style=invis,weight=100];
}
Workspace -> Connection [constraint=false,xlabel="scopes",taillabel="1",headlabel="0..*"];
Workspace -> WorkItem [constraint=false,xlabel="tracks",taillabel="1",headlabel="0..*"];
Connection -> Collection [constraint=false,xlabel="access path",taillabel="1",headlabel="0..*"];
Collection -> ReadAttempt [constraint=false,xlabel="owns",taillabel="1",headlabel="0..*"];
ReadAttempt -> Observation [constraint=false,xlabel="records",taillabel="0..1",headlabel="0..*"];
SourceRevision -> Observation [constraint=false,xlabel="observed as",taillabel="1",headlabel="0..*"];
Observation -> ProjectionRevision [constraint=false,xlabel="immutable inputs",taillabel="0..*",headlabel="0..*"];
SourceRevision -> ProjectionRevision [constraint=false,xlabel="immutable inputs",taillabel="0..*",headlabel="0..*"];
ProjectionRevision -> Snapshot [constraint=false,xlabel="pins",taillabel="0..*",headlabel="0..*"];
SourceRevision -> Snapshot [constraint=false,xlabel="pins",taillabel="0..*",headlabel="0..*"];
Command -> Observation [constraint=false,xlabel="reconciled by",taillabel="0..*",headlabel="0..*"];
WorkItem -> Command [constraint=false,xlabel="related intents",taillabel="0..*",headlabel="0..*"];
}
