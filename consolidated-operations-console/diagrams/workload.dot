digraph Model {
graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.9, ranksep=1.0, newrank=true, splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Consolidated Operations Console — Workload catalogue"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, labelfontsize=9, labeldistance=2.5, labelangle=25, color="#718096", arrowsize=0.65];
subgraph cluster_1 {
label="Workload catalogue"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_1_top [shape=point,width=0,height=0,label="",style=invis];
anchor_1_bottom [shape=point,width=0,height=0,label="",style=invis];
System [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#E7F2EC"><B>System</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">systemId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description: string</FONT></TD></TR></TABLE>>];
UserJourney [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#E7F2EC"><B>UserJourney</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">userJourneyId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">systemId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR></TABLE>>];
Service [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#E7F2EC"><B>Service</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description: string</FONT></TD></TR></TABLE>>];
Dependency [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#E7F2EC"><B>Dependency</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">dependencyId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">targetResourceId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">targetServiceId: Id | null</FONT></TD></TR></TABLE>>];
{rank=same; System;}
anchor_1_top -> System [style=invis,weight=100];
{rank=same; UserJourney; Service;}
UserJourney -> Service [style=invis,weight=100];
System -> UserJourney [style=invis,weight=100];
System -> Service [style=invis,weight=100];
{rank=same; Dependency;}
UserJourney -> Dependency [style=invis,weight=100];
Service -> Dependency [style=invis,weight=100];
Dependency -> anchor_1_bottom [style=invis,weight=100];
}
System -> UserJourney [constraint=false,xlabel="contains",taillabel="1",headlabel="0..*"];
System -> Service [constraint=false,xlabel="membership value",taillabel="0..*",headlabel="0..*"];
UserJourney -> Service [constraint=false,xlabel="membership value",taillabel="0..*",headlabel="0..*"];
Service -> Dependency [constraint=false,xlabel="scopes",taillabel="1",headlabel="0..*"];
}
