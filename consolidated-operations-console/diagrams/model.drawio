          <mxCell style="swimlane;html=0;whiteSpace=nowrap;startSize=40;horizontal=1;rounded=0;fillColor=#E8F2F8;swimlaneFillColor=#FFFFFF;strokeColor=#286783;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=14;fontColor=#203B53;fontFamily=DejaVu Sans;fontSize=18;fontStyle=1;collapsible=0;container=1;dashed=0;" vertex="1" parent="1">
