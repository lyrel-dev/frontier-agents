digraph Model {
graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.9, ranksep=1.0, newrank=true, splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Consolidated Operations Console — AWS Health"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, labelfontsize=9, labeldistance=2.5, labelangle=25, color="#718096", arrowsize=0.65];
subgraph cluster_2 {
label="AWS Health"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_2_top [shape=point,width=0,height=0,label="",style=invis];
anchor_2_bottom [shape=point,width=0,height=0,label="",style=invis];
HealthEvent [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>HealthEvent</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">healthEventId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedSourceRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eventArn: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eventTypeCode: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceCode: string</FONT></TD></TR></TABLE>>];
EventContext [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>EventContext</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eventContextId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">healthEventId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kind: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">accountId: string | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">organizationId: string | null</FONT></TD></TR></TABLE>>];
EntityImpact [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>EntityImpact</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">entityImpactId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eventContextId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedObservationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rawProviderStatus: string | null</FONT></TD></TR></TABLE>>];
Communication [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>Communication</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">communicationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eventContextId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">validatedBaseId: string | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">notificationAccountContext: string | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">groupingRuleDigest: Digest</FONT></TD></TR></TABLE>>];
LifecycleEntry [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>LifecycleEntry</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lifecycleEntryId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">catalogSnapshotId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sourceRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceCode: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title: string</FONT></TD></TR></TABLE>>];
ComponentDeployment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#FFF0DE"><B>ComponentDeployment</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">componentDeploymentId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resourceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">observationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">componentKind: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">versionLabel: string</FONT></TD></TR></TABLE>>];
{rank=same; HealthEvent;}
anchor_2_top -> HealthEvent [style=invis,weight=100];
{rank=same; EventContext;}
HealthEvent -> EventContext [style=invis,weight=100];
{rank=same; EntityImpact; Communication;}
EntityImpact -> Communication [style=invis,weight=100];
EventContext -> EntityImpact [style=invis,weight=100];
EventContext -> Communication [style=invis,weight=100];
{rank=same; LifecycleEntry; ComponentDeployment;}
LifecycleEntry -> ComponentDeployment [style=invis,weight=100];
EntityImpact -> LifecycleEntry [style=invis,weight=100];
EntityImpact -> ComponentDeployment [style=invis,weight=100];
Communication -> LifecycleEntry [style=invis,weight=100];
Communication -> ComponentDeployment [style=invis,weight=100];
LifecycleEntry -> anchor_2_bottom [style=invis,weight=100];
ComponentDeployment -> anchor_2_bottom [style=invis,weight=100];
}
HealthEvent -> EventContext [constraint=false,xlabel="contextualized as",taillabel="1",headlabel="0..*"];
EventContext -> EntityImpact [constraint=false,xlabel="qualified impacts",taillabel="1",headlabel="0..*"];
EventContext -> Communication [constraint=false,xlabel="receives",taillabel="1",headlabel="0..*"];
}
