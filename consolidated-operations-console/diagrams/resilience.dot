digraph Model {
graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.9, ranksep=1.0, newrank=true, splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Consolidated Operations Console — Resilience"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, labelfontsize=9, labeldistance=2.5, labelangle=25, color="#718096", arrowsize=0.65];
subgraph cluster_3 {
label="Resilience"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_3_top [shape=point,width=0,height=0,label="",style=invis];
anchor_3_bottom [shape=point,width=0,height=0,label="",style=invis];
ResiliencePolicy [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EDE9F8"><B>ResiliencePolicy</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resiliencePolicyId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedObservationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">components: List[PolicyComponent]</FONT></TD></TR></TABLE>>];
ResilienceAssessment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EDE9F8"><B>ResilienceAssessment</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resilienceAssessmentId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedObservationId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">policyContextSnapshotId: Id | null</FONT></TD></TR></TABLE>>];
Finding [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EDE9F8"><B>Finding</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">findingId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedSummaryObservationId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedDetailObservationId: Id | null</FONT></TD></TR></TABLE>>];
Recommendation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#EDE9F8"><B>Recommendation</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">recommendationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">serviceId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">findingId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">findingDetailObservationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sourceRevisionId: Id</FONT></TD></TR></TABLE>>];
{rank=same; ResiliencePolicy; ResilienceAssessment;}
ResiliencePolicy -> ResilienceAssessment [style=invis,weight=100];
anchor_3_top -> ResiliencePolicy [style=invis,weight=100];
anchor_3_top -> ResilienceAssessment [style=invis,weight=100];
{rank=same; Finding;}
ResiliencePolicy -> Finding [style=invis,weight=100];
ResilienceAssessment -> Finding [style=invis,weight=100];
{rank=same; Recommendation;}
Finding -> Recommendation [style=invis,weight=100];
Recommendation -> anchor_3_bottom [style=invis,weight=100];
}
Finding -> Recommendation [constraint=false,xlabel="detail suggestions",taillabel="1",headlabel="0..*"];
}
