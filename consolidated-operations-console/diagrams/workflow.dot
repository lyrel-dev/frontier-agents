digraph Model {
graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.9, ranksep=1.0, newrank=true, splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Consolidated Operations Console — Assessment workflow"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, labelfontsize=9, labeldistance=2.5, labelangle=25, color="#718096", arrowsize=0.65];
subgraph cluster_5 {
label="Assessment workflow"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_5_top [shape=point,width=0,height=0,label="",style=invis];
anchor_5_bottom [shape=point,width=0,height=0,label="",style=invis];
Scenario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>Scenario</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">scenarioId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">defaultRevisionId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">localUpdatedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name: string</FONT></TD></TR></TABLE>>];
ScenarioRevision [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>ScenarioRevision</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">scenarioRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">scenarioId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">revisionNumber: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">publishedAt: Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">digest: Digest</FONT></TD></TR></TABLE>>];
Run [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>Run</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">runId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">scenarioRevisionId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">inputSnapshotId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">phase: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">executionOutcome: enum</FONT></TD></TR></TABLE>>];
StepRun [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>StepRun</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">stepRunId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">runId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">phase: enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">stepKey: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedAttemptNo: Version | null</FONT></TD></TR></TABLE>>];
StepAttempt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>StepAttempt</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">stepAttemptId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">runId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">stepRunId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attemptNo: Version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">dispatchKey: Id</FONT></TD></TR></TABLE>>];
{rank=same; Scenario;}
anchor_5_top -> Scenario [style=invis,weight=100];
{rank=same; ScenarioRevision;}
Scenario -> ScenarioRevision [style=invis,weight=100];
{rank=same; Run;}
ScenarioRevision -> Run [style=invis,weight=100];
{rank=same; StepRun;}
Run -> StepRun [style=invis,weight=100];
{rank=same; StepAttempt;}
StepRun -> StepAttempt [style=invis,weight=100];
StepAttempt -> anchor_5_bottom [style=invis,weight=100];
}
subgraph cluster_6 {
label="AWS FIS"; color="#CCD5DF"; fontcolor="#334155"; fontsize=15; style="rounded";
anchor_6_top [shape=point,width=0,height=0,label="",style=invis];
anchor_6_bottom [shape=point,width=0,height=0,label="",style=invis];
Experiment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8492A6"><TR><TD BGCOLOR="#F9E7EA"><B>Experiment</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">experimentId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">identity: SourceIdentity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">templateSourceRevisionId: Id | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">selectedObservationId: Id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rawExperimentState: string</FONT></TD></TR></TABLE>>];
{rank=same; Experiment;}
anchor_6_top -> Experiment [style=invis,weight=100];
Experiment -> anchor_6_bottom [style=invis,weight=100];
}
anchor_5_bottom -> anchor_6_top [style=invis,weight=100,minlen=2];
Scenario -> ScenarioRevision [constraint=false,xlabel="publishes",taillabel="1",headlabel="0..*"];
ScenarioRevision -> Run [constraint=false,xlabel="executed as",taillabel="1",headlabel="0..*"];
Run -> StepRun [constraint=false,xlabel="owns",taillabel="1",headlabel="1..*"];
StepRun -> StepAttempt [constraint=false,xlabel="attempts",taillabel="1",headlabel="0..*"];
StepAttempt -> Experiment [constraint=false,xlabel="external effect reference",taillabel="0..*",headlabel="0..*"];
}
